{
  "policy_version": 1,
  "manifest_contract": {
    "required_fields": [
      "package_version",
      "chromium_version",
      "catalogue_version",
      "platform",
      "artifact",
      "sha256",
      "signature",
      "source_revision",
      "patch_series_sha256",
      "build_manifest_sha256"
    ],
    "additional_fields": false,
    "package_version": "0.1.0",
    "chromium_version": "152.0.7977.83",
    "catalogue_version": 1,
    "platforms": [
      "linux-x64",
      "linux-arm64",
      "macos-arm64",
      "windows-x64"
    ],
    "canonical_json": {
      "encoding": "UTF-8",
      "serialization": "json.dumps(manifest, ensure_ascii=True, sort_keys=True, separators=(\",\", \":\")) + newline",
      "signed_manifest": "the exact manifest object with signature set to null",
      "trailing_newline": true
    },
    "signature_field": {
      "algorithm": "Ed25519",
      "encoding": "RFC4648 padded base64",
      "decoded_length_bytes": 64,
      "detached_signature": true
    }
  },
  "test_vector": {
    "manifest_unsigned_json": "{\"artifact\":\"apostate-152.0.7977.83-linux-x64.tar.zst\",\"build_manifest_sha256\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"catalogue_version\":1,\"chromium_version\":\"152.0.7977.83\",\"package_version\":\"0.1.0\",\"patch_series_sha256\":\"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\",\"platform\":\"linux-x64\",\"sha256\":\"cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc\",\"signature\":null,\"source_revision\":\"1111111111111111111111111111111111111111\"}\n",
    "signature_base64": "MAeeTMY92S1AUqYkS1QIc9vJeb6WmireK91FoQMaDtTMOewhsnS8BXZ9kEyvukm9waT+4aGEyEePPdw8bSbRCw=="
  },
  "artifacts": {
    "filenames": [
      "apostate-152.0.7977.83-linux-x64.tar.zst",
      "apostate-152.0.7977.83-linux-arm64.tar.zst",
      "apostate-152.0.7977.83-macos-arm64.tar.zst",
      "apostate-152.0.7977.83-windows-x64.zip"
    ],
    "hash": {
      "algorithm": "SHA-256",
      "field": "sha256",
      "input": "the exact complete archive bytes",
      "must_match_before_extraction": true
    }
  },
  "signature_verification": {
    "required": true,
    "public_key": ".github/release/public-key.txt",
    "signature_sidecar": "the raw decoded 64-byte value from manifest.signature, stored as ARTIFACT.sig",
    "openssl_verification": "openssl pkeyutl -verify -rawin -pubin -inkey .github/release/public-key.txt -sigfile ARTIFACT.sig -in CANONICAL_UNSIGNED_MANIFEST.json",
    "verify_artifact_hash_before_signature": true,
    "verify_signature_before_extraction": true,
    "reject_missing_signature": true,
    "reject_invalid_signature": true,
    "reject_sidecar_mismatch": true,
    "integrity_is_not_authenticity": true
  },
  "verification_order": [
    "read the manifest before opening or extracting the archive",
    "require exactly the manifest_contract.required_fields and validate artifact binding",
    "hash the complete archive bytes and require an exact match with manifest.sha256",
    "decode manifest.signature as padded base64 and require 64 raw bytes",
    "replace manifest.signature with null and serialize canonical JSON",
    "verify the Ed25519 signature with openssl pkeyutl -rawin",
    "extract only after the hash and signature checks succeed"
  ],
  "extraction_policy": {
    "reject_absolute_paths": true,
    "reject_parent_traversal": true,
    "reject_symbolic_links": true,
    "require_manifest_binding": true
  },
  "key_management": {
    "private_key_storage": "ci-secret:APOSTATE_RELEASE_PRIVATE_KEY",
    "private_key_in_repository": false,
    "private_key_in_artifacts": false
  }
}
