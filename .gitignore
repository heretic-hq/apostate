# Internal-facing material. Never committed — this repo's history is public.
.internal/

# Build artifacts and toolchains (all reproducible from build/ pins)
/src/
/depot_tools/
/out/
*.o
*.a
*.so
*.dylib

# Corpus oracle is generated from resources/, never committed (size + provenance)
/corpus/oracle.sqlite
/corpus/oracle.sqlite-*

# Ledger working state
/ledger/inbox/*.json
!/ledger/inbox/.gitkeep

.DS_Store
__pycache__/
*.pyc
venv/
.venv/

# Third-party fingerprint corpora are never redistributed from this repository.
/resources/fingerprints/raw/vendor/

# Our own captures. Held back until we decide which device profiles ship
# publicly — a published profile is one many people will present as their own.
/resources/fingerprints/raw/*.json
