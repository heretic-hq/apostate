+// Apostate: the device profile this process presents, as base64-encoded JSON.
+//
+// Carried on the command line because it must be readable before anything else
+// runs: mojo is initialised after field trials, and a value read before the
+// profile arrives is the host's real value. Command-line switches are not
+// readable by web content, so carrying it here discloses nothing to a page.
+inline constexpr char kApostateProfile[] = "apostate-profile";
+
 // Delays execution of TaskPriority::BEST_EFFORT tasks until shutdown.
 inline constexpr char kDisableBestEffortTasks[] = "disable-best-effort-tasks";
 
