+// Copyright 2026 The Apostate Authors
+// Use of this source code is governed by a GPL-3.0 license that can be
+// found in the LICENSE file.
+
+#include "base/apostate/profile.h"
+
+#include <memory>
+#include <utility>
+
+#include "base/base64.h"
+#include "base/base_switches.h"
+#include "base/command_line.h"
+#include "base/json/json_reader.h"
+#include "base/logging.h"
+#include "base/no_destructor.h"
+#include "base/values.h"
+
+namespace base::apostate {
+
+namespace {
+
+// Owned for process lifetime. Written once during InitializeFromCommandLine and
+// read without locking thereafter, which is only sound because initialisation
+// happens before any consumer runs.
+const Profile* g_profile = nullptr;
+const Profile* g_profile_for_testing = nullptr;
+
+}  // namespace
+
+Profile::Profile() = default;
+Profile::~Profile() = default;
+
+// static
+const Profile* Profile::Get() {
+  if (g_profile_for_testing) {
+    return g_profile_for_testing;
+  }
+  return g_profile;
+}
+
+// static
+void Profile::SetForTesting(const Profile* profile) {
+  g_profile_for_testing = profile;
+}
+
+// static
+Profile* Profile::ParseOrNull(const std::string& encoded) {
+  std::string json;
+  if (!Base64Decode(encoded, &json)) {
+    LOG(ERROR) << "apostate: profile switch is not valid base64; ignoring";
+    return nullptr;
+  }
+
+  // Strict RFC parsing: a profile is machine-generated, so comments and
+  // trailing commas would only mask a generator bug.
+  std::optional<DictValue> dict = JSONReader::ReadDict(json, JSON_PARSE_RFC);
+  if (!dict) {
+    LOG(ERROR) << "apostate: profile is not a JSON object; ignoring";
+    return nullptr;
+  }
+
+  auto profile = std::make_unique<Profile>();
+
+  if (const std::string* id = dict->FindString("id")) {
+    profile->source_id_ = *id;
+  }
+
+  // Absent fields stay absent. A profile that does not describe a surface must
+  // leave it inherited rather than have a default invented here, because an
+  // invented value is wrong in a way no consumer can detect.
+  if (const DictValue* cpu = dict->FindDict("cpu")) {
+    if (std::optional<int> cores = cpu->FindInt("logical_cores")) {
+      if (*cores > 0) {
+        profile->cpu_logical_cores_ = *cores;
+      } else {
+        LOG(ERROR) << "apostate: cpu.logical_cores must be positive; ignoring";
+      }
+    }
+  }
+
+  if (const DictValue* memory = dict->FindDict("memory")) {
+    // JSON numbers are doubles, and installed memory exceeds 2^53 in no
+    // realistic case, but a double still cannot represent an arbitrary uint64.
+    // Reading it as a double and converting is honest about the precision the
+    // wire format actually has.
+    if (std::optional<double> total = memory->FindDouble("total_bytes")) {
+      if (*total > 0) {
+        profile->memory_total_bytes_ = static_cast<uint64_t>(*total);
+      } else {
+        LOG(ERROR) << "apostate: memory.total_bytes must be positive; ignoring";
+      }
+    }
+  }
+
+  return profile.release();
+}
+
+// static
+void Profile::InitializeFromCommandLine() {
+  if (g_profile) {
+    return;
+  }
+
+  const CommandLine* command_line = CommandLine::ForCurrentProcess();
+  if (!command_line->HasSwitch(switches::kApostateProfile)) {
+    return;
+  }
+
+  g_profile = ParseOrNull(
+      command_line->GetSwitchValueASCII(switches::kApostateProfile));
+}
+
+}  // namespace base::apostate
diff --git a/base/apostate/profile.h b/base/apostate/profile.h
new file mode 100644
index 0000000..3d896d8
--- /dev/null
+++ b/base/apostate/profile.h
@@ -0,0 +1,87 @@
+// Copyright 2026 The Apostate Authors
+// Use of this source code is governed by a GPL-3.0 license that can be
+// found in the LICENSE file.
+
+#ifndef BASE_APOSTATE_PROFILE_H_
+#define BASE_APOSTATE_PROFILE_H_
+
+#include <cstdint>
+#include <optional>
+#include <string>
+
+#include "base/base_export.h"
+
+namespace base::apostate {
+
+// The device profile this process is presenting.
+//
+// Lives in base/ because the values it carries are consumed by base/ itself —
+// SysInfo is the first consumer — and base cannot depend on content or chrome.
+// That also makes it reachable from every process type without a layering
+// violation.
+//
+// Availability is the whole design constraint. A value read before the profile
+// is parsed is the host's real value, and a process that never receives the
+// profile reports the host's real value; both are observable from a page and
+// neither is visible in the surface the profile was meant to fix. So the
+// profile arrives on the command line, which is the only channel present before
+// anything else runs. Mojo is initialised after field trials and is therefore
+// too late — see docs/subsystems/profile-loader.md.
+//
+// Every getter returns nullopt when no profile is configured or when the
+// profile does not carry that field. Callers must fall through to the real
+// value rather than substituting a default: a made-up value is worse than the
+// host's, because it is wrong in a way nothing can predict.
+class BASE_EXPORT Profile {
+ public:
+  // Parses the profile from the current process's command line. Idempotent, and
+  // safe to call before most of base is initialised. Must be called before any
+  // consumer reads a value; consumers that run earlier will see no profile.
+  static void InitializeFromCommandLine();
+
+  // Null when this process has no profile. Never owns; valid for process
+  // lifetime.
+  static const Profile* Get();
+
+  // Overrides the profile for tests. Passing nullptr clears it.
+  static void SetForTesting(const Profile* profile);
+
+  Profile();
+  ~Profile();
+
+  Profile(const Profile&) = delete;
+  Profile& operator=(const Profile&) = delete;
+
+  // Number of logical processors the profile claims.
+  //
+  // A claim above the host's real count is permitted but weakly detectable: a
+  // worker scaling curve plateaus at the host's real capacity whatever this
+  // says. Claims at or below it are free. The loader clamps rather than
+  // refusing, because a browser that will not launch is a worse trade than a
+  // rarely probed weak signal.
+  std::optional<int> cpu_logical_cores() const { return cpu_logical_cores_; }
+
+  // Total physical memory in bytes.
+  //
+  // Note this is the *real* installed figure, not the value navigator.deviceMemory
+  // reports. Blink rounds to a power of two and clamps to [2, 32] GiB on
+  // desktop, so storing the bucketed value directly would let an out-of-bucket
+  // number ship. Reproducing Chromium's own rounding from a real figure cannot.
+  std::optional<uint64_t> memory_total_bytes() const {
+    return memory_total_bytes_;
+  }
+
+  // Identifier of the capture this profile was derived from, for diagnostics.
+  const std::string& source_id() const { return source_id_; }
+
+ private:
+  static Profile* ParseOrNull(const std::string& encoded);
+
+  std::optional<int> cpu_logical_cores_;
+  std::optional<uint64_t> memory_total_bytes_;
+  std::string source_id_;
+};
+
+}  // namespace base::apostate
+
+#endif  // BASE_APOSTATE_PROFILE_H_
