 }
 
+namespace {
+
+// Capture devices the claimed machine has and the build host does not.
+//
+// Injected here rather than at enumerateDevices() because this is where every
+// enumeration result lands: the same snapshot feeds the cache, device-change
+// events and getUserMedia's device selection, so a device added at the
+// accessor would be one the rest of the browser does not believe in.
+//
+// The identifiers are opaque on purpose. MediaDevicesDispatcherHost replaces
+// every device_id with a per-origin HMAC before it reaches a renderer, so the
+// raw string is never observable and does not need to imitate a platform's
+// naming. "default" and "communications" are deliberately not used: those are
+// special-cased downstream and mean something specific.
+void AppendProfileDevices(MediaDeviceType type,
+                          blink::WebMediaDeviceInfoArray* snapshot) {
+  const base::apostate::Profile* profile = base::apostate::Profile::Get();
+  if (!profile) {
+    return;
+  }
+
+  std::optional<int> wanted;
+  const char* prefix = nullptr;
+  switch (type) {
+    case MediaDeviceType::kMediaAudioInput:
+      wanted = profile->media_audioinput_count();
+      prefix = "apostate-audioinput-";
+      break;
+    case MediaDeviceType::kMediaVideoInput:
+      wanted = profile->media_videoinput_count();
+      prefix = "apostate-videoinput-";
+      break;
+    default:
+      return;
+  }
+  if (!wanted.has_value()) {
+    return;
+  }
+
+  // Top up rather than replace. If the host genuinely has capture hardware,
+  // those devices are real and stay; the profile only sets the floor. Removing
+  // real devices to hit an exact count would break capture on a machine that
+  // can actually capture.
+  for (size_t i = snapshot->size(); i < static_cast<size_t>(*wanted); ++i) {
+    snapshot->emplace_back(prefix + base::NumberToString(i),
+                           std::string() /* label */,
+                           prefix + base::NumberToString(i) + "-group");
+  }
+}
+
+}  // namespace
+
 void MediaDevicesManager::DevicesEnumerated(
     uint64_t request_id,
     MediaDeviceType type,
-    const blink::WebMediaDeviceInfoArray& snapshot) {
+    const blink::WebMediaDeviceInfoArray& snapshot_in) {
   DCHECK_CURRENTLY_ON(BrowserThread::IO);
   DCHECK(blink::IsValidMediaDeviceType(type));
+  blink::WebMediaDeviceInfoArray snapshot = snapshot_in;
+  AppendProfileDevices(type, &snapshot);
   UpdateSnapshot(type, snapshot);
   cache_infos_[static_cast<size_t>(type)].UpdateCompleted();
   cache_is_populated_[static_cast<size_t>(type)] = true;
