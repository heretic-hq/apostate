Subject: [PATCH] fonts: select Apple outline bounds through the profile loader

Blink uses outline-path bounds for Apple glyph metrics and integer SkGlyph
bounds elsewhere. Select that existing producer behavior for an Apple profile
in the shared single-glyph, batch-glyph and HarfBuzz extent helpers. The policy
uses the existing immutable ua_platform profile field in Blink; Skia does not
receive a second Chromium singleton or a new cross-process interface.

Skip the FreeType-only VDMX and descent-borrowing adjustments under this Apple
policy. CSS font descriptors still override ascent/descent. Unprofiled behavior
retains the build platform's policy, and Windows-profile metric selection stays
unchanged pending exact DirectWrite table/line-gap evidence.

Reference: resources/fingerprints/raw/m4-max-chrome-20260908T163229Z.json,
fonts.metrics, contains fractional actual glyph bounds at40px. This patch uses
the real glyph outlines rather than replaying those reference numbers. It does
not establish CoreText raster equality, font-resource identity, fallback
selection or matching advances. Bitmap-only glyphs retain the upstream bounds
fallback. No TextMetrics/DOMRect accessors are modified.

Primary source at Chromium79460ebecaa5625e57a5fb679a735659e73dc687:
- platform/fonts/skia/skia_text_metrics.cc:96-155,177-193: Apple path bounds.
- platform/fonts/font_metrics.cc:72-132: FreeType-only VDMX/descent adjustment.
All paths above are under third_party/blink/renderer/.

Ledger proposal: fonts.metric-policy-conformance. V1/V3 remain required.
diff --git a/third_party/blink/renderer/platform/fonts/font_metrics.cc b/third_party/blink/renderer/platform/fonts/font_metrics.cc
index 11f9a7e..7a622b5 100644
--- a/third_party/blink/renderer/platform/fonts/font_metrics.cc
+++ b/third_party/blink/renderer/platform/fonts/font_metrics.cc
@@ -33,6 +33,7 @@
 #include "base/containers/span.h"
 #include "build/build_config.h"
 #include "third_party/blink/renderer/platform/fonts/font_platform_data.h"
+#include "third_party/blink/renderer/platform/fonts/skia/skia_text_metrics.h"
 #include "third_party/blink/renderer/platform/fonts/vdmx_parser.h"
 #include "third_party/blink/renderer/platform/wtf/math_extras.h"
 #include "third_party/skia/include/core/SkFont.h"
@@ -77,7 +78,8 @@ void FontMetrics::AscentDescentWithHacks(
   static const uint32_t kVdmxTag = SkSetFourByteTag('V', 'D', 'M', 'X');
   int pixel_size = ClampTo<int>(platform_data.size() + 0.5);
   // TODO(xiaochengh): How do we support ascent/descent override with VDMX?
-  if (!ascent_override && !descent_override && !font.isForceAutoHinting() &&
+  if (!UseAppleFontMetricPolicy() && !ascent_override && !descent_override &&
+      !font.isForceAutoHinting() &&
       (font.getHinting() == SkFontHinting::kFull ||
        font.getHinting() == SkFontHinting::kNormal)) {
     size_t vdmx_size = face->getTableSize(kVdmxTag);
@@ -123,7 +125,7 @@ void FontMetrics::AscentDescentWithHacks(
     // the descent part of the glyph may be truncated when displayed in a
     // 'overflow: hidden' container.  To avoid that, borrow 1 unit from the
     // ascent when possible.
-    if (descent < metrics.fDescent &&
+    if (!UseAppleFontMetricPolicy() && descent < metrics.fDescent &&
         platform_data.GetFontRenderStyle().use_subpixel_positioning &&
         ascent >= 1) {
       ++descent;
diff --git a/third_party/blink/renderer/platform/fonts/skia/skia_text_metrics.cc b/third_party/blink/renderer/platform/fonts/skia/skia_text_metrics.cc
index 3ea05e0..0f37e8f 100644
--- a/third_party/blink/renderer/platform/fonts/skia/skia_text_metrics.cc
+++ b/third_party/blink/renderer/platform/fonts/skia/skia_text_metrics.cc
@@ -4,6 +4,7 @@
 
 #include "third_party/blink/renderer/platform/fonts/skia/skia_text_metrics.h"
 
+#include "base/apostate/profile.h"
 #include "base/containers/span.h"
 #include "build/build_config.h"
 #include "third_party/blink/renderer/platform/fonts/shaping/harfbuzz_face.h"
@@ -14,6 +15,15 @@
 
 namespace blink {
 
+bool UseAppleFontMetricPolicy() {
+  if (const auto* profile = base::apostate::Profile::Get()) {
+    if (const auto& platform = profile->ua_platform()) {
+      return *platform == "macOS" || *platform == "iOS";
+    }
+  }
+  return BUILDFLAG(IS_APPLE);
+}
+
 void SkFontGetGlyphWidthForHarfBuzz(const SkStrikeRef& strike_ref,
                                     bool subpixel,
                                     hb_codepoint_t codepoint,
@@ -93,17 +103,17 @@ void SkFontGetGlyphExtentsForHarfBuzz(const SkFont& font,
   SkRect sk_bounds;
   uint16_t glyph = codepoint;
 
-#if BUILDFLAG(IS_APPLE)
-  // TODO(drott): Remove this once we have better metrics bounds
-  // on Mac, https://bugs.chromium.org/p/skia/issues/detail?id=5328
-  if (const auto path = font.getPath(glyph)) {
-    sk_bounds = path->getBounds();
+  if (UseAppleFontMetricPolicy()) {
+    // Use the same outline geometry as the Apple glyph-bound producer below.
+    // HarfBuzz uses these extents to position marks without font anchors.
+    if (const auto path = font.getPath(glyph)) {
+      sk_bounds = path->getBounds();
+    } else {
+      sk_bounds = font.getBounds(glyph, nullptr);
+    }
   } else {
     sk_bounds = font.getBounds(glyph, nullptr);
   }
-#else
-  sk_bounds = font.getBounds(glyph, nullptr);
-#endif
   if (!font.isSubpixel()) {
     // Use roundOut() rather than round() to avoid rendering glyphs
     // outside the visual overflow rect. crbug.com/452914.
@@ -121,7 +131,6 @@ void SkFontGetGlyphExtentsForHarfBuzz(const SkFont& font,
 // Returns path-based bounds for float precision, falling back to
 // font.getBounds() for bitmap-only glyphs (e.g. color emoji) that have no
 // paths.
-#if BUILDFLAG(IS_APPLE)
 static void GetPathBoundsForGlyph(const SkFont& font,
                                   Glyph glyph,
                                   SkRect* bounds) {
@@ -137,14 +146,12 @@ static void GetPathBoundsForGlyph(const SkFont& font,
     bounds->set(ir);
   }
 }
-#endif
 
 void SkFontGetBoundsForGlyph(const SkFont& font, Glyph glyph, SkRect* bounds) {
-#if BUILDFLAG(IS_APPLE)
-  // TODO(drott): Remove this once we have better metrics bounds
-  // on Mac, https://bugs.chromium.org/p/skia/issues/detail?id=5328
-  GetPathBoundsForGlyph(font, glyph, bounds);
-#else
+  if (UseAppleFontMetricPolicy()) {
+    GetPathBoundsForGlyph(font, glyph, bounds);
+    return;
+  }
   *bounds = font.getBounds(glyph, nullptr);
 
   if (!font.isSubpixel()) {
@@ -152,7 +159,6 @@ void SkFontGetBoundsForGlyph(const SkFont& font, Glyph glyph, SkRect* bounds) {
     bounds->roundOut(&ir);
     bounds->set(ir);
   }
-#endif
 }
 
 void SkFontGetPreciseBoundsForGlyph(const SkFont& font,
@@ -177,11 +183,12 @@ void SkFontGetPreciseBoundsForGlyph(const SkFont& font,
 void SkFontGetBoundsForGlyphs(const SkFont& font,
                               const Vector<Glyph, 256>& glyphs,
                               base::span<SkRect> bounds) {
-#if BUILDFLAG(IS_APPLE)
-  for (unsigned i = 0; i < glyphs.size(); i++) {
-    SkFontGetBoundsForGlyph(font, glyphs[i], &bounds[i]);
+  if (UseAppleFontMetricPolicy()) {
+    for (unsigned i = 0; i < glyphs.size(); i++) {
+      GetPathBoundsForGlyph(font, glyphs[i], &bounds[i]);
+    }
+    return;
   }
-#else
   static_assert(sizeof(Glyph) == 2, "Skia expects 2 bytes glyph id.");
   font.getBounds(glyphs, {bounds.data(), glyphs.size()}, nullptr);
 
@@ -192,7 +199,6 @@ void SkFontGetBoundsForGlyphs(const SkFont& font,
       bounds[i].set(ir);
     }
   }
-#endif
 }
 
 float SkFontGetWidthForGlyph(const SkFont& font, Glyph glyph) {
diff --git a/third_party/blink/renderer/platform/fonts/skia/skia_text_metrics.h b/third_party/blink/renderer/platform/fonts/skia/skia_text_metrics.h
