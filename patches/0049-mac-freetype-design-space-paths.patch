+// A geometry policy must not reuse the native strike descriptor, even when
+// typeface, size, hinting and transform are otherwise identical.
+DEF_TEST(Font_design_space_identity, reporter) {
+    SkFont native(ToolUtils::SampleUserTypeface());
+    REPORTER_ASSERT(reporter, !native.isDesignSpacePaths());
+    for (float size : {1.5f, 40.f, 64.f, 128.f}) {
+        native.setSize(size);
+        SkFont design = native;
+        design.setDesignSpacePaths(true);
+        REPORTER_ASSERT(reporter, design != native);
+        REPORTER_ASSERT(reporter, serialize_deserialize(design, reporter).isDesignSpacePaths());
+        SkScalerContextRec nativeRec, designRec;
+        SkScalerContextEffects nativeEffects, designEffects;
+        SkScalerContext::MakeRecAndEffectsFromFont(native, &nativeRec, &nativeEffects);
+        SkScalerContext::MakeRecAndEffectsFromFont(design, &designRec, &designEffects);
+        REPORTER_ASSERT(reporter, !(nativeRec.fFlags & SkScalerContext::kDesignSpacePaths_Flag));
+        REPORTER_ASSERT(reporter, designRec.fFlags & SkScalerContext::kDesignSpacePaths_Flag);
+        const auto nativeDescriptor =
+            SkScalerContext::DescriptorGivenRecAndEffects(nativeRec, nativeEffects);
+        const auto designDescriptor =
+            SkScalerContext::DescriptorGivenRecAndEffects(designRec, designEffects);
+        REPORTER_ASSERT(reporter, *nativeDescriptor != *designDescriptor);
+        design.setDesignSpacePaths(false);
+        REPORTER_ASSERT(reporter, design == native);
+    }
+}
+
+#if defined(SK_TYPEFACE_FACTORY_FREETYPE)
+// Synthetic bold keeps the original transform-before-embolden producer.
+// Compare complete real paths, including cold/warm interleaving and fonts
+// whose local matrix is nonuniform, skewed, reflected or below FreeType's 1px floor.
+DEF_TEST(Font_design_space_bold_fallback, reporter) {
+    auto stream = GetResourceAsStream("fonts/Roboto-Regular.ttf");
+    REPORTER_ASSERT(reporter, stream);
+    if (!stream) { return; }
+    auto typeface = SkTypeface_FreeType::MakeFromStream(std::move(stream), SkFontArguments());
+    REPORTER_ASSERT(reporter, typeface);
+    if (!typeface) { return; }
+    SkFont native(typeface);
+    native.setEmbolden(true);
+    native.setHinting(SkFontHinting::kNone);
+    const SkGlyphID glyph = native.unicharToGlyph('A');
+    REPORTER_ASSERT(reporter, glyph != 0);
+    for (float size : {1.5f, 18.f, 40.f, 63.5f, 128.f}) {
+        for (float scale : {0.005f, 0.5f, 1.f, 2.f, -1.f}) {
+            for (float skew : {-0.75f, 0.f, 0.5f}) {
+                native.setSize(size);
+                native.setScaleX(scale);
+                native.setSkewX(skew);
+                SkFont design = native;
+                design.setDesignSpacePaths(true);
+                auto expected = native.getPath(glyph);
+                auto actual = design.getPath(glyph);
+                REPORTER_ASSERT(reporter, expected.has_value());
+                REPORTER_ASSERT(reporter, actual == expected);
+                REPORTER_ASSERT(reporter, native.getPath(glyph) == expected);
+                REPORTER_ASSERT(reporter, design.getPath(glyph) == expected);
+            }
+        }
+    }
+}
+#endif
