 using SkUniqueFTFace = std::unique_ptr<FT_FaceRec, SkFunctionObject<FT_Done_Face>>;
 using SkUniqueFTSize = std::unique_ptr<FT_SizeRec, SkFunctionObject<FT_Done_Size>>;
+
+// Owns only a temporary size. The shared face's variation coordinates and
+// synthesis policy are never changed. Restore size and transform even when a
+// size activation or glyph load fails, before destroying the temporary size.
+class ScopedFTDesignSpacePath {
+public:
+    explicit ScopedFTDesignSpacePath(FT_Face face)
+            : fFace(face), fPreviousSize(face->size) {
+        FT_Get_Transform(fFace, &fPreviousTransform, &fPreviousDelta);
+    }
+    ~ScopedFTDesignSpacePath() {
+        FT_Activate_Size(fPreviousSize);
+        FT_Set_Transform(fFace, &fPreviousTransform, &fPreviousDelta);
+        if (fDesignSize) {
+            FT_Done_Size(fDesignSize);
+        }
+    }
+    ScopedFTDesignSpacePath(const ScopedFTDesignSpacePath&) = delete;
+    ScopedFTDesignSpacePath& operator=(const ScopedFTDesignSpacePath&) = delete;
+
+    bool load(FT_UInt glyph, FT_Int32 flags) {
+        if (fDesignSize || !fFace->units_per_EM || FT_IS_TRICKY(fFace) ||
+            FT_New_Size(fFace, &fDesignSize) || FT_Activate_Size(fDesignSize) ||
+            FT_Set_Char_Size(fFace, static_cast<FT_F26Dot6>(fFace->units_per_EM) * 64,
+                             static_cast<FT_F26Dot6>(fFace->units_per_EM) * 64, 72, 72)) {
+            return false;
+        }
+        FT_Set_Transform(fFace, nullptr, nullptr);
+        // Normal glyph loading resolves composites and keeps the driver
+        // precision for variations. NO_SCALE would round gvar coordinates.
+        flags &= ~(FT_LOAD_NO_SCALE | FT_LOAD_NO_RECURSE | FT_LOAD_RENDER |
+                   FT_LOAD_FORCE_AUTOHINT);
+        flags |= FT_LOAD_NO_HINTING | FT_LOAD_NO_BITMAP | FT_LOAD_IGNORE_TRANSFORM;
+        return FT_Load_Glyph(fFace, glyph, flags) == 0 &&
+               fFace->glyph->format == FT_GLYPH_FORMAT_OUTLINE;
+    }
+
+private:
+    FT_Face fFace;
+    FT_Size fPreviousSize;
+    FT_Matrix fPreviousTransform;
+    FT_Vector fPreviousDelta;
+    FT_Size fDesignSize = nullptr;
+};
+
 }
 
 // SK_FREETYPE_MINIMUM_RUNTIME_VERSION 0x<major><minor><patch><flags>
@@ -1525,6 +1570,44 @@
     // FT_IS_SCALABLE is documented to mean the face contains outline glyphs.
     if (!FT_IS_SCALABLE(fFace) || this->setupSize()) {
         return {};
+    }
+
+    // Synthetic bold is a nonlinear operation applied after FreeType's
+    // transform. Keep its original path and operation order unchanged.
+    // Color/SVG/sbix faces also retain the color-aware original path, even
+    // when a glyph has a monochrome fallback outline.
+    if ((fRec.fFlags & SkScalerContext::kDesignSpacePaths_Flag) &&
+        !(fRec.fFlags & SkScalerContext::kEmbolden_Flag) &&
+        !FT_HAS_COLOR(fFace) && !FT_HAS_SVG(fFace) && !FT_HAS_SBIX(fFace) &&
+        fRec.getHinting() == SkFontHinting::kNone && !FT_IS_TRICKY(fFace)) {
+        ScopedFTDesignSpacePath designSpace(fFace);
+        if (!designSpace.load(glyphID, fLoadGlyphFlags)) {
+            return {};
+        }
+        bool modified = false;
+        SkPathBuilder builder;
+        if (!fUtils.generateGlyphPath(fFace, &builder)) {
+            return {};
+        }
+        // Metrics and outline are both in fractional design units here.
+        // Apply the vertical-origin offset before the same float transform.
+        if (this->isVertical()) {
+            builder.offset(
+                SkFDot6ToScalar(fFace->glyph->metrics.vertBearingX -
+                               fFace->glyph->metrics.horiBearingX),
+                SkFDot6ToScalar(fFace->glyph->metrics.vertBearingY +
+                               fFace->glyph->metrics.horiBearingY));
+            modified = true;
+        }
+        // Recompute the unadjusted matrix: fMatrix22Scalar may already
+        // compensate for FreeType's minimum 1px size at tiny scaleX values.
+        SkVector scale;
+        SkMatrix transform;
+        fRec.computeMatrices(SkScalerContextRec::PreMatrixScale::kFull, &scale, &transform);
+        const SkScalar upem = SkIntToScalar(fFace->units_per_EM);
+        transform.preScale(scale.x() / upem, scale.y() / upem);
+        builder.transform(transform);
+        return {{builder.detach(), modified}};
     }
 
     uint32_t flags = fLoadGlyphFlags;
