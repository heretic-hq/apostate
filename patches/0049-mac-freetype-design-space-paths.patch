diff --git a/third_party/skia/src/core/SkScalerContext.cpp b/third_party/skia/src/core/SkScalerContext.cpp
--- a/third_party/skia/src/core/SkScalerContext.cpp
+++ b/third_party/skia/src/core/SkScalerContext.cpp
@@ -1190,6 +1190,10 @@
     if (font.isLinearMetrics()) {
         flags |= SkScalerContext::kLinearMetrics_Flag;
     }
+    if (font.isDesignSpacePaths()) {
+        // fFlags is part of the full scaler record in every strike descriptor.
+        flags |= SkScalerContext::kDesignSpacePaths_Flag;
+    }
     if (font.isBaselineSnap()) {
         flags |= SkScalerContext::kBaselineSnap_Flag;
     }
diff --git a/third_party/skia/src/core/SkScalerContext.h b/third_party/skia/src/core/SkScalerContext.h
--- a/third_party/skia/src/core/SkScalerContext.h
+++ b/third_party/skia/src/core/SkScalerContext.h
@@ -281,6 +281,7 @@
         kBaselineSnap_Flag        = 0x2000,
 
         kNeedsForegroundColor_Flag = 0x4000,
