+             SkSetFourByteTag('S', 'V', 'G', ' '), SkSetFourByteTag('s', 'b', 'i', 'x'),
+             SkSetFourByteTag('C', 'O', 'L', 'R'), SkSetFourByteTag('C', 'P', 'A', 'L'),
+             SkSetFourByteTag('C', 'B', 'D', 'T'), SkSetFourByteTag('C', 'B', 'L', 'C'),
+             SkSetFourByteTag('E', 'B', 'D', 'T'), SkSetFourByteTag('E', 'B', 'L', 'C'),
+             SkSetFourByteTag('E', 'B', 'S', 'C'), SkSetFourByteTag('b', 'd', 'a', 't'),
+             SkSetFourByteTag('b', 'l', 'o', 'c'), SkSetFourByteTag('f', 'v', 'a', 'r')}) {
+        if (fontations_ffi::table_data(font, tag, 0, rust::Slice<uint8_t>())) {
+            return true;
+        }
+    }
+    return false;
 }
 
