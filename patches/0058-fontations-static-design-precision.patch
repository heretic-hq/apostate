+  for (float value : {axis.min, axis.def, axis.max}) {
+    const SkFontArguments::VariationPosition::Coordinate coordinate{axis.tag, value};
+    SkFontArguments args;
+    args.setVariationDesignPosition({&coordinate, 1});
+    auto instance = typeface->makeClone(args);
+    ASSERT_TRUE(instance);
+    SkFont font(instance, 17.25f);
+    font.setHinting(SkFontHinting::kNone);
+    font.setEmbeddedBitmaps(false);
+    ExpectUnchanged(font, glyph);
+  }
+}
+
+TEST_F(FontationsDesignSpaceTest, ColorSvgAndBitmapFacesRetainBaseline) {
+  struct Case { const char* name; SkFontTableTag tag; SkUnichar character; };
+  for (const auto& item : {
+           Case{"Fontations-SampleSVG.ttf", SkSetFourByteTag('S','V','G',' '), 'a'},
+           Case{"Fontations-sbix.ttf", SkSetFourByteTag('s','b','i','x'), 0x2662},
+           Case{"Fontations-cbdt.ttf", SkSetFourByteTag('C','B','D','T'), 0x2662},
+           Case{"Fontations-colr.ttf", SkSetFourByteTag('C','O','L','R'), 0x2662}}) {
+    SCOPED_TRACE(item.name);
+    auto typeface = Load(item.name);
+    ASSERT_TRUE(typeface);
+    ASSERT_GT(typeface->getTableSize(item.tag), 0u);
+    const auto glyph = typeface->unicharToGlyph(item.character);
+    ASSERT_NE(glyph, 0);
+    SkFont font(typeface, 17.25f);
+    font.setHinting(SkFontHinting::kNone);
+    font.setEmbeddedBitmaps(false);
+    ExpectUnchanged(font, glyph);
+  }
+}
