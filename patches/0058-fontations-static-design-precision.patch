+struct GlyphSnapshot {
+  SkVector advance;
+  std::optional<SkPath> path;
+  bool path_modified = false;
+};
+
+class FontationsDesignSpaceTest : public testing::Test {
+ protected:
+  sk_sp<SkTypeface> Load(const char* name) {
+    base::FilePath directory;
+    if (!base::PathService::Get(base::DIR_EXE, &directory)) {
+      ADD_FAILURE() << "Executable directory unavailable";
+      return nullptr;
+    }
+    const auto path = directory.AppendASCII("test_fonts").AppendASCII(name);
+    auto data = SkData::MakeFromFileName(path.value().c_str());
+    if (!data) {
+      ADD_FAILURE() << "Font resource unavailable: " << path.value();
+      return nullptr;
+    }
+    // Exercise the browser's actual scanner factory, never a platform fallback.
+    return SkTypeface_Make_Fontations(SkMemoryStream::Make(std::move(data)),
+                                      SkFontArguments());
+  }
+
+  void SetUp() override {
+    typeface_ = Load("DesignSpaceRoboto-Regular.ttf");
+    ASSERT_TRUE(typeface_);
+    ASSERT_EQ(typeface_->getUnitsPerEm(), 2048);
+    ASSERT_EQ(typeface_->getVariationDesignParameters({}), 0);
+    glyph_ = typeface_->unicharToGlyph('A');
+    ASSERT_NE(glyph_, 0);
+  }
+
+  GlyphSnapshot Snapshot(const SkFont& font, SkGlyphID glyph_id,
+                         float device_scale = 1.f, bool quarter_turn = false) {
+    SkScalerContextRec rec;
+    SkScalerContextEffects effects;
+    SkScalerContext::MakeRecAndEffectsFromFont(font, &rec, &effects);
+    rec.fPost2x2[0][0] = device_scale;
+    rec.fPost2x2[1][1] = device_scale;
+    if (quarter_turn) {
+      rec.fPost2x2[0][0] = 0.f;
+      rec.fPost2x2[0][1] = -device_scale;
+      rec.fPost2x2[1][0] = device_scale;
+      rec.fPost2x2[1][1] = 0.f;
+    }
+    auto descriptor = SkScalerContext::DescriptorGivenRecAndEffects(rec, effects);
+    auto scaler = font.getTypeface()->createScalerContext(effects, &*descriptor);
+    EXPECT_TRUE(scaler);
+    if (!scaler) {
+      return {};
+    }
+    SkArenaAlloc arena(4096);
+    auto glyph = scaler->makeGlyph(SkPackedGlyphID(glyph_id), &arena);
+    scaler->getPath(glyph, &arena);
+    GlyphSnapshot result{glyph.advanceVector()};
+    if (const SkPath* path = glyph.path()) {
+      result.path = *path;
+      result.path_modified = glyph.pathIsModified();
+    }
+    return result;
+  }
+
+  void ExpectUnchanged(const SkFont& native, SkGlyphID glyph) {
+    SkFont design = native;
+    design.setDesignSpacePaths(true);
+    auto before = Snapshot(native, glyph, 8193.f / 8192.f);
+    auto flagged = Snapshot(design, glyph, 8193.f / 8192.f);
+    auto after = Snapshot(native, glyph, 8193.f / 8192.f);
+    EXPECT_EQ(flagged.advance, before.advance);
+    EXPECT_EQ(flagged.path, before.path);
+    EXPECT_EQ(flagged.path_modified, before.path_modified);
+    EXPECT_EQ(after.advance, before.advance);
+    EXPECT_EQ(after.path, before.path);
+    EXPECT_EQ(design.getWidth(glyph), native.getWidth(glyph));
+  }
+
+  sk_sp<SkTypeface> typeface_;
+  SkGlyphID glyph_ = 0;
+};
+
+TEST_F(FontationsDesignSpaceTest, StaticAdvanceUsesDesignUnitsAndSeparateCache) {
+  // Roboto A has an hmtx advance of1336 in2048 units/em. The first size is
+  // finer than a26.6 ppem quantum; the native fixed-point path rounds it.
+  for (float size : {8193.f / 8192.f, 1.5f, 17.25f, 40.f, 63.5f, 128.f}) {
+    SCOPED_TRACE(size);
+    SkFont native(typeface_, size);
+    native.setHinting(SkFontHinting::kNone);
+    native.setEmbeddedBitmaps(false);
+    native.setLinearMetrics(true);
+    native.setSubpixel(true);
+    SkFont design = native;
+    design.setDesignSpacePaths(true);
+    const float expected = static_cast<float>(1336.0 * size / 2048.0);
+    const float before = native.getWidth(glyph_);
+    EXPECT_EQ(design.getWidth(glyph_), expected);
+    EXPECT_EQ(native.getWidth(glyph_), before);
+    EXPECT_EQ(design.getWidth(glyph_), expected);
+    if (size == 8193.f / 8192.f) {
+      EXPECT_NE(before, expected);
+    }
+  }
+}
+
+TEST_F(FontationsDesignSpaceTest, TruncatedMetricsRetainNativeFallback) {
+  // Preserve the native parser's rejection when a selected advance is present
+  // but the complete hmtx array is truncated. Only an in-memory test copy changes.
+  int index = -1;
+  auto stream = typeface_->openStream(&index);
+  ASSERT_TRUE(stream);
+  ASSERT_EQ(index, 0);
+  auto data = SkData::MakeFromStream(stream.get(), stream->getLength());
+  ASSERT_TRUE(data);
+  ASSERT_GE(data->size(), 12u);
+  std::vector<uint8_t> bytes(data->size());
+  ASSERT_EQ(data->copyRange(0, bytes.size(), bytes.data()), bytes.size());
+  const uint16_t tables = static_cast<uint16_t>((bytes[4] << 8) | bytes[5]);
+  ASSERT_GE(data->size(), 12u + static_cast<size_t>(tables) * 16u);
+  const uint32_t truncated = static_cast<uint32_t>(glyph_) * 4u + 2u;
+  bool changed = false;
+  for (uint16_t table = 0; table < tables; ++table) {
+    const size_t record = 12u + static_cast<size_t>(table) * 16u;
+    if (bytes[record] == 'h' && bytes[record + 1] == 'm' &&
+        bytes[record + 2] == 't' && bytes[record + 3] == 'x') {
+      ASSERT_GT(typeface_->getTableSize(SkSetFourByteTag('h', 'm', 't', 'x')),
+                truncated);
+      bytes[record + 12] = static_cast<uint8_t>(truncated >> 24);
+      bytes[record + 13] = static_cast<uint8_t>(truncated >> 16);
+      bytes[record + 14] = static_cast<uint8_t>(truncated >> 8);
+      bytes[record + 15] = static_cast<uint8_t>(truncated);
+      changed = true;
+      break;
+    }
+  }
+  ASSERT_TRUE(changed);
+  auto broken_data = SkData::MakeWithCopy(bytes.data(), bytes.size());
+  auto broken = SkTypeface_Make_Fontations(
+      SkMemoryStream::Make(std::move(broken_data)), SkFontArguments());
+  ASSERT_TRUE(broken);
+  ASSERT_EQ(broken->getTableSize(SkSetFourByteTag('h', 'm', 't', 'x')), truncated);
+  ASSERT_EQ(broken->unicharToGlyph('A'), glyph_);
+  SkFont native(broken, 17.25f);
+  native.setHinting(SkFontHinting::kNone);
+  native.setEmbeddedBitmaps(false);
+  SkFont design = native;
+  design.setDesignSpacePaths(true);
+  EXPECT_EQ(native.getWidth(glyph_), 0.f);
+  EXPECT_EQ(design.getWidth(glyph_), native.getWidth(glyph_));
+}
+
+TEST_F(FontationsDesignSpaceTest, StaticOutlineScalesBeforeFloatStorage) {
+  // Fontations extracts at the vertical scale and applies scaleX afterwards.
+  // A fractional device scale tests its extractor precision directly; merely
+  // changing scaleX at canonical64 is not a counterexample for this UPEM.
+  SkFont native(typeface_, 64.f);
+  native.setHinting(SkFontHinting::kNone);
+  native.setEmbeddedBitmaps(false);
+  const float device_scale = 8193.f / 8192.f;
+  const double size = 64.0 * device_scale;
+  const SkRect expected = SkRect::MakeLTRB(
+      static_cast<float>(28.0 * size / 2048.0),
+      static_cast<float>(-1456.0 * size / 2048.0),
+      static_cast<float>(1309.0 * size / 2048.0), 0.f);
+  SkFont design = native;
+  design.setDesignSpacePaths(true);
+  const auto baseline = Snapshot(native, glyph_, device_scale);
+  const auto precise = Snapshot(design, glyph_, device_scale);
+  ASSERT_TRUE(baseline.path);
+  ASSERT_TRUE(precise.path);
+  EXPECT_FALSE(precise.path->isEmpty());
+  EXPECT_EQ(precise.path->getBounds(), expected);
+  EXPECT_NE(precise.path->getBounds(), baseline.path->getBounds());
+  EXPECT_EQ(precise.path_modified, baseline.path_modified);
+  EXPECT_EQ(Snapshot(native, glyph_, device_scale).path, baseline.path);
+  EXPECT_EQ(Snapshot(design, glyph_, device_scale).path, precise.path);
+}
+
+TEST_F(FontationsDesignSpaceTest, PostMatrixRotationPreservesEachBranch) {
+  const SkMatrix rotation = SkMatrix::MakeAll(0.f, -1.f, 0.f, 1.f, 0.f, 0.f,
+                                             0.f, 0.f, 1.f);
+  for (bool design : {false, true}) {
+    SkFont font(typeface_, 64.f);
+    font.setHinting(SkFontHinting::kNone);
+    font.setEmbeddedBitmaps(false);
+    font.setDesignSpacePaths(design);
+    const auto horizontal = Snapshot(font, glyph_, 8193.f / 8192.f);
+    const auto rotated = Snapshot(font, glyph_, 8193.f / 8192.f, true);
+    ASSERT_TRUE(horizontal.path);
+    ASSERT_TRUE(rotated.path);
+    EXPECT_EQ(rotated.path, horizontal.path->tryMakeTransform(rotation));
+    EXPECT_EQ(rotated.advance, rotation.mapPoint(horizontal.advance));
+    EXPECT_TRUE(rotated.path_modified);
+  }
+}
