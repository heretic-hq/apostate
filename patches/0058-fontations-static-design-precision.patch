+// Read only the requested table bytes through the existing checked bridge.
+std::optional<uint16_t> designTableU16(const fontations_ffi::BridgeFontRef& font,
+                                     SkFontTableTag tag, size_t offset) {
+    uint8_t bytes[2];
+    if (fontations_ffi::table_data(font, tag, offset, rust::Slice<uint8_t>(bytes, 2)) != 2) {
+        return {};
+    }
+    return static_cast<uint16_t>((bytes[0] << 8) | bytes[1]);
+}
