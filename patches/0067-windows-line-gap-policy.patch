From: Apostate <apostate@example.invalid>
Subject: [apostate 0067/0067] Windows: zero line-gap policy for line-height normal

DirectWrite-backed SkFonts report fLeading 0 for fonts whose hhea line
gap Chromium on Linux/FreeType would otherwise fold into
FontMetrics::line_spacing (used line-height for `line-height: normal`).
Verified on Consolas 24px: mac/win reference row implies used 28px
(round(22.08)+round(6.02)+0), while unpatched Linux yields 32px
(22+6+round(350/2048*24)). Author-specified line heights
(line_gap_override) still win; the policy only replaces the
FreeType-derived default.

diff --git a/third_party/blink/renderer/platform/fonts/simple_font_data.cc b/third_party/blink/renderer/platform/fonts/simple_font_data.cc
--- a/third_party/blink/renderer/platform/fonts/simple_font_data.cc
+++ b/third_party/blink/renderer/platform/fonts/simple_font_data.cc
@@ -37,5 +37,6 @@
 #include <utility>
 
+#include "base/apostate/profile.h"
 #include "base/compiler_specific.h"
 #include "base/memory/ptr_util.h"
 #include "build/build_config.h"
@@ -87,8 +88,23 @@
   if (metrics_override.line_gap_override) {
     line_gap = *metrics_override.line_gap_override * platform_data_->size();
   } else {
     line_gap = metrics.fLeading;
+    // APOSTATE(win-line-gap): the reference Windows stack derives line
+    // spacing without a FreeType line gap (DirectWrite reports fLeading 0
+    // for these families), so when emulating Windows ignore the
+    // FreeType-derived gap. Author line-height overrides take the branch
+    // above and are unaffected. Windows detection matches 0066
+    // (profile ua_platform).
+    bool zero_line_gap = false;
+    if (const auto* profile = base::apostate::Profile::Get()) {
+      if (const auto& platform = profile->ua_platform()) {
+        zero_line_gap = (*platform == "Windows");
+      }
+    }
+    if (zero_line_gap) {
+      line_gap = 0.0f;
+    }
   }
   font_metrics_.SetLineGap(line_gap);
   font_metrics_.SetLineSpacing(lroundf(ascent) + lroundf(descent) +
                                lroundf(line_gap));
