+// Bounds for the numeric overrides. Generous, because they exist only to stop
+// an overflow and a typo from becoming a profile, not to second-guess an
+// operator who knows their target.
+constexpr int kMaxOverrideCores = 4096;
+constexpr int kMaxOverridePixels = 65535;
+constexpr int kMaxOverrideMemoryGib = 4096;
+
+// The switches that only mean something when a profile is composed at all.
+constexpr std::string_view kShapingSwitches[] = {
+    switches::kFingerprintPlatform,
+    switches::kFingerprintAnchor,
+    switches::kFingerprintGpuVendor,
+    switches::kFingerprintGpuRenderer,
+    switches::kFingerprintHardwareConcurrency,
+    switches::kFingerprintDeviceMemory,
+    switches::kFingerprintScreenWidth,
+    switches::kFingerprintScreenHeight,
+    switches::kFingerprintTimezone,
+    switches::kFingerprintLocale,
+};
+
+bool ParseIntOverride(const CommandLine& command_line,
+                      std::string_view name,
+                      int maximum,
+                      std::optional<int>* out,
+                      std::string* rejection) {
+  if (!command_line.HasSwitch(name)) {
+    return true;
+  }
+  const std::string raw = command_line.GetSwitchValueASCII(name);
+  int value = 0;
+  if (!StringToInt(raw, &value) || value <= 0 || value > maximum) {
+    *rejection = "--" + std::string(name) + "='" + raw +
+                 "' is not a whole number between 1 and " +
+                 NumberToString(maximum) + ".";
+    return false;
+  }
+  *out = value;
+  return true;
+}
+
+bool ParseTextOverride(const CommandLine& command_line,
+                       std::string_view name,
+                       std::string* out,
+                       std::string* rejection) {
+  if (!command_line.HasSwitch(name)) {
+    return true;
+  }
+  std::string value = command_line.GetSwitchValueASCII(name);
+  if (value.empty() || value.size() > 256) {
+    *rejection = "--" + std::string(name) +
+                 " was given an empty or over-long value.";
+    return false;
+  }
+  *out = std::move(value);
+  return true;
+}
+
+// Reads the per-field overrides off the command line and range-checks them.
+//
+// A malformed value stops the launch rather than being dropped. An operator
+// who mistypes --fingerprint-hardware-concurrency=eigth and is not told will
+// run a whole session believing the field was pinned, which is the failure
+// this whole codebase exists to avoid.
+bool CollectOverrides(const CommandLine& command_line,
+                      FieldOverrides* overrides,
+                      std::string* rejection) {
+  return ParseTextOverride(command_line, switches::kFingerprintGpuVendor,
+                           &overrides->gpu_vendor, rejection) &&
+         ParseTextOverride(command_line, switches::kFingerprintGpuRenderer,
+                           &overrides->gpu_renderer, rejection) &&
+         ParseTextOverride(command_line, switches::kFingerprintTimezone,
+                           &overrides->timezone, rejection) &&
+         ParseTextOverride(command_line, switches::kFingerprintLocale,
+                           &overrides->accept_languages, rejection) &&
+         ParseIntOverride(command_line,
+                          switches::kFingerprintHardwareConcurrency,
+                          kMaxOverrideCores, &overrides->logical_cores,
+                          rejection) &&
+         ParseIntOverride(command_line, switches::kFingerprintScreenWidth,
+                          kMaxOverridePixels, &overrides->screen_width,
+                          rejection) &&
+         ParseIntOverride(command_line, switches::kFingerprintScreenHeight,
+                          kMaxOverridePixels, &overrides->screen_height,
+                          rejection) &&
+         [&] {
+           std::optional<int> gib;
+           if (!ParseIntOverride(command_line,
+                                 switches::kFingerprintDeviceMemory,
+                                 kMaxOverrideMemoryGib, &gib, rejection)) {
+             return false;
+           }
+           if (gib) {
+             // The switch is in GiB because that is the unit
+             // navigator.deviceMemory reports in; the profile field is real
+             // installed bytes, which Chromium then rounds to the nearer power
+             // of two itself.
+             overrides->memory_bytes =
+                 static_cast<uint64_t>(*gib) * 1024u * 1024u * 1024u;
+           }
+           return true;
+         }();
+}
