+constexpr std::string_view kLayerOverride = "command-line";
+
+// The identity one gpu_identity option carries, read back out of its
+// fragment. The fragment is the only place the pair lives as a unit; the
+// anchor's member list is what it must agree with, and that agreement is
+// checked after the draw as it always was.
+ClaimedIdentity IdentityOfOption(std::string_view axis,
+                                 const DispersionOption& option) {
+  return IdentityFromProfile(ParseFragment(axis, option.value_json));
+}
+
+// Narrows a gpu_identity option set to the identity the launch named.
+//
+// An override is a restriction on the draw rather than a value written over
+// the finished profile, and that is the whole of why it stays coherent: the
+// chosen option is still a catalogue option, still a measured member of the
+// resolved anchor, and still the thing the WebGPU adapter and the GL
+// capability cluster are read from. Writing a renderer string over the
+// composed profile instead would leave GL limits, extensions and precisions
+// measured on different silicon underneath it -- a contradiction a page can
+// see in one getParameter call, and a stronger signal than the real renderer
+// would have been.
+//
+// Returns false with `rejection` filled when nothing servable matches.
+bool NarrowToNamedIdentity(std::vector<const DispersionOption*>& options,
+                           std::string_view axis,
+                           const FieldOverrides& overrides,
+                           const Anchor& anchor,
+                           std::string* rejection) {
+  if (overrides.gpu_vendor.empty() && overrides.gpu_renderer.empty()) {
+    return true;
+  }
+
+  std::vector<const DispersionOption*> kept;
+  std::vector<std::string> servable_renderers;
+  for (const DispersionOption* option : options) {
+    const ClaimedIdentity identity = IdentityOfOption(axis, *option);
+    if (!identity.declared) {
+      continue;
+    }
+    servable_renderers.push_back(identity.vendor + " / " + identity.renderer);
+    if (!overrides.gpu_vendor.empty() &&
+        identity.vendor != overrides.gpu_vendor) {
+      continue;
+    }
+    if (!overrides.gpu_renderer.empty() &&
+        identity.renderer != overrides.gpu_renderer) {
+      continue;
+    }
+    kept.push_back(option);
+  }
+
+  if (!kept.empty()) {
+    options = std::move(kept);
+    return true;
+  }
+
+  std::string named;
+  if (!overrides.gpu_vendor.empty()) {
+    named += "--fingerprint-gpu-vendor='" + overrides.gpu_vendor + "'";
+  }
+  if (!overrides.gpu_renderer.empty()) {
+    if (!named.empty()) {
+      named += " with ";
+    }
+    named += "--fingerprint-gpu-renderer='" + overrides.gpu_renderer + "'";
+  }
+
+  std::string offer;
+  for (const std::string& renderer : servable_renderers) {
+    offer += "\n  " + renderer;
+  }
+  if (offer.empty()) {
+    offer = "\n  (none)";
+  }
+
+  if (rejection) {
+    *rejection =
+        named +
+        " names a GPU identity that was not measured on the capability cluster "
+        "this host can serve. The GL limits, extensions, shader precisions and "
+        "WebGPU adapter all come from anchor '" +
+        std::string(anchor.id) +
+        "', so a renderer from outside it would be contradicted by its own "
+        "capability table. Servable on this host:" +
+        offer +
+        "\nPass --fingerprint-anchor to choose a different cluster, or "
+        "--fingerprint-explain to see what this host can serve.";
+  }
+  return false;
+}
+
+// Records one overridden surface so --fingerprint-explain says who decided the
+// value and what it displaced.
+void RecordOverride(Composition& composition,
+                    std::string_view surface,
+                    const std::string& value,
+                    const std::string& note) {
+  composition.surfaces.push_back({
+      .surface = std::string(surface),
+      .value = value,
+      .layer = std::string(kLayerOverride),
+      .evidence = "operator",
+      .limitation = note,
+  });
+  composition.limitations.push_back(std::string(surface) + ": " + note);
+}
+
+// The note every scalar override carries. An override is honoured, but it is
+// not backed by the prevalence data the catalogue's buckets are, and saying so
+// is the difference between a tool and a trap: an operator who pins seven
+// cores has a more distinctive machine than any seed would have produced, and
+// only they can know whether that is what they wanted.
+std::string OverrideNote(std::string_view field, const std::string& displaced) {
+  std::string note = std::string(field) +
+                     " was set from the command line rather than drawn from "
+                     "the catalogue, so its real-world prevalence is unknown "
+                     "and it may be more distinctive than a drawn value";
+  if (!displaced.empty()) {
+    note += "; the seed had chosen " + displaced;
+  }
+  return note;
+}
+
+// Applies the scalar overrides onto the composed profile.
+//
+// Called after the axis loop and before DeriveWorkArea, so that a screen
+// override has its available rectangle derived from the same furniture insets
+// the seed drew rather than from the panel it replaced. Returns false with
+// `rejection` filled when an override cannot be served.
+bool ApplyScalarOverrides(Composition& composition,
+                          const ComposeRequest& request,
+                          bool panel_resolved,
+                          std::string* rejection) {
+  const FieldOverrides& overrides = request.overrides;
+  const HostCapability& host = request.host;
+
+  if (overrides.logical_cores) {
+    const int claimed = *overrides.logical_cores;
+    if (ClampLogicalCores(claimed, host.logical_cores) != claimed) {
+      if (rejection) {
+        *rejection = "--fingerprint-hardware-concurrency=" +
+                     NumberToString(claimed) + " is above this host's " +
+                     NumberToString(host.logical_cores) +
+                     " logical cores. A page can measure parallel throughput, "
+                     "so a count the machine cannot deliver is falsifiable in "
+                     "a way a lower count is not. Pass a value of " +
+                     NumberToString(host.logical_cores) + " or less.";
+      }
+      return false;
+    }
+    DictValue* cpu = composition.profile.EnsureDict("cpu");
+    const std::optional<int> displaced = cpu->FindInt("logical_cores");
+    cpu->Set("logical_cores", claimed);
+    RecordOverride(composition, "cpu", NumberToString(claimed),
+                   OverrideNote("cpu.logical_cores",
+                                displaced ? NumberToString(*displaced)
+                                          : std::string()));
+  }
+
+  if (overrides.memory_bytes) {
+    const uint64_t claimed = *overrides.memory_bytes;
+    if (ClampMemoryBytes(claimed, host.total_memory_bytes) != claimed) {
+      if (rejection) {
+        *rejection = "--fingerprint-device-memory names " +
+                     NumberToString(claimed) +
+                     " bytes, which is above this host's " +
+                     NumberToString(host.total_memory_bytes) +
+                     ". A page can allocate until it fails, so claiming more "
+                     "memory than the machine has is falsifiable in a way "
+                     "claiming less is not.";
+      }
+      return false;
+    }
+    DictValue* memory = composition.profile.EnsureDict("memory");
+    const std::optional<double> displaced = memory->FindDouble("total_bytes");
+    memory->Set("total_bytes", static_cast<double>(claimed));
+    RecordOverride(
+        composition, "memory", NumberToString(claimed) + " bytes",
+        OverrideNote("memory.total_bytes",
+                     displaced ? NumberToString(static_cast<uint64_t>(
+                                     *displaced)) + " bytes"
+                               : std::string()));
+  }
+
+  if (!overrides.screen_width && !overrides.screen_height) {
+    return true;
+  }
+
+  DictValue* screen = composition.profile.EnsureDict("screen");
+  const int width =
+      overrides.screen_width.value_or(screen->FindInt("width").value_or(0));
+  const int height =
+      overrides.screen_height.value_or(screen->FindInt("height").value_or(0));
+
+  if ((host.window_width > 0 && width < host.window_width) ||
+      (host.window_height > 0 && height < host.window_height)) {
+    if (rejection) {
+      *rejection = "the overridden screen is " + NumberToString(width) + "x" +
+                   NumberToString(height) +
+                   ", smaller than the --window-size this launch asked for (" +
+                   NumberToString(host.window_width) + "x" +
+                   NumberToString(host.window_height) +
+                   "). A window larger than the screen it claims to be on is "
+                   "visible from JavaScript in one comparison.";
+    }
+    return false;
+  }
+
+  const int inset_left = screen->FindInt("avail_inset_left").value_or(0);
+  const int inset_right = screen->FindInt("avail_inset_right").value_or(0);
+  const int inset_top = screen->FindInt("avail_inset_top").value_or(0);
+  const int inset_bottom = screen->FindInt("avail_inset_bottom").value_or(0);
+  if (inset_left + inset_right >= width ||
+      inset_top + inset_bottom >= height) {
+    if (rejection) {
+      *rejection = "the overridden screen is " + NumberToString(width) + "x" +
+                   NumberToString(height) +
+                   ", which the desktop furniture this seed drew does not fit "
+                   "inside (" + NumberToString(inset_left) + "+" +
+                   NumberToString(inset_right) + " horizontal, " +
+                   NumberToString(inset_top) + "+" +
+                   NumberToString(inset_bottom) +
+                   " vertical). Choose a larger screen or a different seed.";
+    }
+    return false;
+  }
+
+  if (overrides.screen_width) {
+    const std::optional<int> displaced = screen->FindInt("width");
+    screen->Set("width", width);
+    RecordOverride(composition, "screen.width", NumberToString(width),
+                   OverrideNote("screen.width",
+                                displaced ? NumberToString(*displaced)
+                                          : std::string()));
+  }
+  if (overrides.screen_height) {
+    const std::optional<int> displaced = screen->FindInt("height");
+    screen->Set("height", height);
+    RecordOverride(composition, "screen.height", NumberToString(height),
+                   OverrideNote("screen.height",
+                                displaced ? NumberToString(*displaced)
+                                          : std::string()));
+  }
+
+  if (!panel_resolved) {
+    composition.limitations.push_back(
+        "screen: the panel axis was left inherited and the screen size came "
+        "from the command line, so colour depth, pixel ratio, gamut and HDR "
+        "are still the host's and the available rectangle is not derived");
+  }
+  return true;
+}
