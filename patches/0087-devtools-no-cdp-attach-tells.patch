+void V8Debugger::updateUncaughtExceptionStackCapture() {
+  // Uncaught-exception stack capture is an isolate-wide switch and its cost is
+  // paid by page script, not by the front-end: V8 walks the live JS stack on
+  // the throwing thread, so the cost of a `throw` grows with call depth.
+  // Because the capture flag can be flipped by Runtime.enable alone, a page
+  // could measure `throw` at two call depths and read the ratio as a boolean
+  // "a CDP client is attached", with no baseline to calibrate against.
+  //
+  // Gate it on the debug delegate, which only Debugger.enable installs. A
+  // front-end that is actually debugging - DevTools enables the Debugger
+  // domain on attach - still gets exception stack traces, and the states this
+  // browser can be in remain states stock Chrome can also be in: delegate
+  // absent behaves exactly like Chrome with nothing attached, delegate present
+  // exactly like Chrome with DevTools open.
+  //
+  // Upstream's own precondition is kept: no enabled Runtime domain means no
+  // capture, so this only ever narrows what upstream would have asked for.
+  const bool runtimeEnabled = !m_maxCallStackSizeToCaptureMap.empty();
+  const bool debuggerActive = m_enableCount > 0;
+  if (!runtimeEnabled || !debuggerActive || m_maxCallStackSizeToCapture <= 0) {
+    m_isolate->SetCaptureStackTraceForUncaughtExceptions(false);
+    return;
+  }
+  m_isolate->SetCaptureStackTraceForUncaughtExceptions(
+      true, m_maxCallStackSizeToCapture);
+}
