+// Switch names spelled as literals because base/ cannot include ui/gl,
+// content/public or chrome/common. All three are stable, all three are cited,
+// and none is readable by web content.
 //
 // "use-angle": ui/gl/gl_switches.cc kUseANGLE, with the backend value names
 // from kANGLEImplementation*Name in the same file.
+// "disable-gpu": content/public/common/content_switches.cc kDisableGpu.
 // "window-size": chrome/common/chrome_switches.cc kWindowSize, "w,h" in DIP.
 constexpr char kUseANGLESwitch[] = "use-angle";
+constexpr char kDisableGpuSwitch[] = "disable-gpu";
 constexpr char kWindowSizeSwitch[] = "window-size";
 
+// The Anchor::backend token for the software rasteriser. No anchor captured
+// through hardware can be served on it, which is the whole point of naming it.
+constexpr char kSoftwareBackend[] = "swiftshader";
+
 // The backend ANGLE selects when nothing overrides it.
 //
 // Grounded in this project's own T0 captures rather than asserted: the corpus
@@ -82,12 +93,61 @@
       value == "gles-egl") {
     return "gl";
   }
-  if (value == "swiftshader" || value == "swiftshader-webgl") {
-    return "swiftshader";
+  if (value == kSoftwareBackend || value == "swiftshader-webgl") {
+    return kSoftwareBackend;
   }
   return std::string_view();
 }
 
+// True when this host has no hardware graphics device for ANGLE to use, so
+// every backend above it resolves to the software rasteriser whatever the
+// platform default says.
+//
+// Implemented for Linux because that is where the case is real: a cloud
+// instance or a container without GPU passthrough has no /dev/dri at all, and
+// a server with nothing but an EFI framebuffer has /dev/dri/card0 and no
+// render node. ANGLE's Vulkan and GL backends both reach hardware through a
+// render node, so the render node rather than the directory is the fact that
+// decides it.
+//
+// The answer is one-way on purpose. Absence means ANGLE will fall back to
+// software. Presence means only that it probably will not: a render node with
+// no usable driver behind it still ends in software, and --use-angle states
+// that by hand. Being wrong in the presence direction leaves today's
+// behaviour; being wrong in the absence direction is what produces a discrete
+// GPU claim on a host that renders in software, so the check only ever moves
+// the answer towards software.
+//
+// access() rather than base::PathExists() because this is a devfs syscall on
+// the startup path and ProbeHostCapability's header promises no blocking I/O:
+// access() carries no blocking-call assertion, and a host with no /dev/dri
+// costs exactly one of them. R_OK|W_OK because the GPU process opens the node
+// read-write, so a node it could not open is not a device it can use.
+bool HostHasNoGpuDevice() {
+#if BUILDFLAG(IS_LINUX)
+  if (access("/dev/dri", X_OK) != 0) {
+    return true;
+  }
+  // DRM render nodes are minor numbers from 128 upward, assigned densely, one
+  // per device. Eight covers eight GPUs; past that the answer is the same.
+  // Not named `minor`: glibc has a history of defining that as a macro in
+  // sys/sysmacros.h, which <unistd.h> can reach.
+  for (int node_minor = 128; node_minor < 136; ++node_minor) {
+    const std::string node =
+        StrCat({"/dev/dri/renderD", NumberToString(node_minor)});
+    if (access(node.c_str(), R_OK | W_OK) == 0) {
+      return false;
+    }
+  }
+  return true;
+#else
+  // Windows and macOS have no equivalent one-syscall answer -- it would take
+  // a D3D11 or Metal device creation, which is the GPU process's job -- so the
+  // backend stays the platform default there and --use-angle states it.
+  return false;
+#endif
+}
+
 }  // namespace
 
