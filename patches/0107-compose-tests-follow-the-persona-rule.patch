-TEST(ApostateComposeTest, AnAnchorIsRequiredToBeServableByTheHostBackend) {
+// The other half of 0102, and the reason the old assertion was withdrawn: a
+// backend match is not a coherence requirement, because the host's backend is
+// not what a page is being told about. The persona is.
+TEST(ApostateComposeTest, AnAnchorIsNotRequiredToMatchTheHostBackend) {
   constexpr DispersionAxis kAxes[] = {kOsReleaseAxis};
-  HostCapability host = CapableHost();
-  host.graphics_backend = "d3d11";
 
-  // The only compiled anchor is Metal. Presenting its cluster through D3D11 is
-  // the retired catalogue's exact failure, so there is nothing to fall back to
-  // and composition declines rather than inventing a cluster.
-  EXPECT_FALSE(Compose(RequestFor("no-anchor", kAxes, host)).has_value());
+  // A windows persona on a Metal host: the D3D11 cluster is served over a
+  // backend that did not produce it, and composition proceeds.
+  const std::optional<Composition> cross =
+      Compose(RequestFor("cross-backend", kAxes, CapableHost()));
+  ASSERT_TRUE(cross.has_value());
+  EXPECT_EQ("test-d3d11", ChosenId(*cross, "anchor"));
+
+  // Including when the host has no hardware backend at all, which is the
+  // deployment target. Before 0102 this selected the software anchor.
+  HostCapability gpuless = CapableHost();
+  gpuless.graphics_backend = "swiftshader";
+  gpuless.platform = "linux";
+  const std::optional<Composition> software =
+      Compose(RequestFor("gpuless", kAxes, gpuless));
+  ASSERT_TRUE(software.has_value());
+  EXPECT_EQ("test-d3d11", ChosenId(*software, "anchor"));
+
+  // And the mismatch is recorded rather than hidden, because the backend still
+  // decides which extension names the host's GL stack can back.
+  bool reported = false;
+  for (const std::string& limitation : software->limitations) {
+    reported = reported ||
+               limitation.find("cluster on a swiftshader host") !=
+                   std::string::npos;
+  }
+  EXPECT_TRUE(reported) << "a cross-backend cluster must say so";
+}
+
+// The software anchor is excluded by its own rule at the top of the candidate
+// loop, not as a side effect of the absent backend filter, so re-adding any
+// backend preference cannot make it drawable. It is weighted 1000 against the
+// others' 1 here, so a draw that considered it at all would pick it.
+TEST(ApostateComposeTest, TheSoftwareAnchorIsNeverDrawn) {
+  constexpr DispersionAxis kAxes[] = {kOsReleaseAxis};
+  HostCapability gpuless = CapableHost();
+  gpuless.graphics_backend = "swiftshader";
+  gpuless.platform = "linux";
+
+  // Every seed, because this is a property of the candidate set rather than of
+  // one draw, and a single seed could pass by luck.
+  for (int seed = 0; seed < 24; ++seed) {
+    ComposeRequest request =
+        RequestFor("software-" + NumberToString(seed), kAxes, gpuless);
+    const std::optional<Composition> composition = Compose(request);
+    ASSERT_TRUE(composition.has_value()) << "seed " << seed;
+    EXPECT_EQ("test-d3d11", ChosenId(*composition, "anchor")) << "seed " << seed;
+  }
+
+  // Naming it explicitly still serves it, because a pin is an explicit
+  // request: un-defaulted, not removed.
+  ComposeRequest pinned = RequestFor("software-pinned", kAxes, gpuless);
+  pinned.pinned_anchor = "test-swiftshader";
+  const std::optional<Composition> composition = Compose(pinned);
+  ASSERT_TRUE(composition.has_value());
+  EXPECT_EQ("test-swiftshader", ChosenId(*composition, "anchor"));
 }
 
