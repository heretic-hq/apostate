{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/apostate/apostate/blob/main/ledger/schema/compatibility-acceptance.schema.json",
  "title": "Apostate compatibility acceptance index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalogue_id",
    "catalogue_version",
    "profile_schema_version",
    "browser_build",
    "acceptance_track",
    "offering_policy",
    "capture_inventory",
    "probe_requirements",
    "families"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "catalogue_id": {"const": "apostate"},
    "catalogue_version": {"const": 1},
    "profile_schema_version": {"const": 2},
    "browser_build": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "acceptance_track": {"const": "V3-C/V4-C"},
    "offering_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initial_catalogue_status",
        "physical_reference_required_for_t0",
        "physical_t0_closure",
        "raw_compatibility_corpus_redistributed",
        "native_capability_ceiling"
      ],
      "properties": {
        "initial_catalogue_status": {"const": "offered"},
        "physical_reference_required_for_t0": {"const": true},
        "physical_t0_closure": {"const": "never"},
        "raw_compatibility_corpus_redistributed": {"const": false},
        "native_capability_ceiling": {"const": "enforced"}
      }
    },
    "capture_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reported_compatibility_captures",
        "normalized_named_families",
        "normalization_mapping_status",
        "collector_sha256",
        "raw_imported"
      ],
      "properties": {
        "reported_compatibility_captures": {"type": "integer", "minimum": 1},
        "normalized_named_families": {"type": "integer", "minimum": 1},
        "normalization_mapping_status": {"const": "private-not-redistributed"},
        "collector_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "raw_imported": {"const": false}
      }
    },
    "probe_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repeatability_runs", "coherence_check_ids", "held_out_probe_ids", "webgl_surface_ids", "webgpu_surface_ids"],
      "properties": {
        "repeatability_runs": {"type": "integer", "minimum": 2},
        "coherence_check_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
        "held_out_probe_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
        "webgl_surface_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
        "webgpu_surface_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true}
      }
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/family"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"type": "string", "enum": ["offered", "validated", "provisional", "limited", "unvalidated"]},
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverage", "status"],
      "properties": {
        "coverage": {"type": "string", "enum": ["present", "absent", "not-captured", "inherited"]},
        "status": {"$ref": "#/$defs/status"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime",
        "capture_set_id",
        "normalized_source_sha256",
        "collector_sha256",
        "browser_build",
        "probe_set_version",
        "raw_capture_redistributed",
        "physical_reference"
      ],
      "properties": {
        "runtime": {"type": "string", "enum": ["gologin"]},
        "capture_set_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "normalized_source_sha256": {"$ref": "#/$defs/sha256"},
        "collector_sha256": {"$ref": "#/$defs/sha256"},
        "browser_build": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "probe_set_version": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "raw_capture_redistributed": {"const": false},
        "physical_reference": {"const": false}
      }
    },
    "repeatability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "required_runs", "observed_runs", "same_input_identity", "stable_fields", "failures"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "required_runs": {"type": "integer", "minimum": 2},
        "observed_runs": {"type": "integer", "minimum": 0},
        "same_input_identity": {"type": ["string", "null"]},
        "stable_fields": {"type": "array", "items": {"type": "string"}},
        "failures": {"type": "array", "items": {"type": "string"}}
      }
    },
    "coherence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checks"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "status"],
            "properties": {"id": {"type": "string", "minLength": 1}, "status": {"$ref": "#/$defs/status"}}
          }
        }
      }
    },
    "held_out": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "results"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["probe_id", "input_sha256", "expected_sha256", "observed_sha256", "status"],
            "properties": {
              "probe_id": {"type": "string", "minLength": 1},
              "input_sha256": {"type": ["string", "null"]},
              "expected_sha256": {"type": ["string", "null"]},
              "observed_sha256": {"type": ["string", "null"]},
              "status": {"$ref": "#/$defs/status"}
            }
          }
        }
      }
    },
    "detector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "result", "suite_id", "suite_version", "run_id", "target_class", "receipt_sha256", "raw_receipt_retained", "raw_receipt_redistributed"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "result": {"type": "string", "enum": ["not-run", "reported-pass", "pass", "fail"]},
        "suite_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "suite_version": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "minLength": 1},
        "target_class": {"type": "string", "enum": ["real-world", "synthetic", "not-run"]},
        "receipt_sha256": {"type": ["string", "null"]},
        "raw_receipt_retained": {"type": "boolean"},
        "raw_receipt_redistributed": {"const": false}
      }
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family_id", "platform", "evidence_class", "status", "source", "surfaces", "receipts", "receipt_references", "native_constraints", "known_limitations"],
      "properties": {
        "family_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "platform": {"type": "string", "enum": ["macos", "windows"]},
        "evidence_class": {"const": "compatibility-capture"},
        "status": {"type": "string", "enum": ["offered", "validated", "provisional", "limited"]},
        "source": {"$ref": "#/$defs/source"},
        "surfaces": {
          "type": "object",
          "additionalProperties": false,
          "required": ["webgl", "webgpu"],
          "properties": {
            "webgl": {
              "type": "object",
              "additionalProperties": false,
              "required": ["identity", "extensions", "limits", "precision", "allocation", "readback", "shader_compilation", "cluster_claim"],
              "properties": {
                "identity": {"$ref": "#/$defs/surface"},
                "extensions": {"$ref": "#/$defs/surface"},
                "limits": {"$ref": "#/$defs/surface"},
                "precision": {"$ref": "#/$defs/surface"},
                "allocation": {"$ref": "#/$defs/surface"},
                "readback": {"$ref": "#/$defs/surface"},
                "shader_compilation": {"$ref": "#/$defs/surface"},
                "cluster_claim": {"type": "string", "enum": ["not-claimed", "full"]}
              }
            },
            "webgpu": {
              "type": "object",
              "additionalProperties": false,
              "required": ["identity", "features", "limits", "execution"],
              "properties": {
                "identity": {"$ref": "#/$defs/surface"},
                "features": {"$ref": "#/$defs/surface"},
                "limits": {"$ref": "#/$defs/surface"},
                "execution": {"$ref": "#/$defs/surface"}
              }
            }
          }
        },
        "receipts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repeatability", "coherence", "held_out", "detector"],
          "properties": {
            "repeatability": {"$ref": "#/$defs/repeatability"},
            "coherence": {"$ref": "#/$defs/coherence"},
            "held_out": {"$ref": "#/$defs/held_out"},
            "detector": {"$ref": "#/$defs/detector"}
          }
        },
        "receipt_references": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "id", "sha256", "retained"],
            "properties": {
              "kind": {"type": "string", "enum": ["repeatability", "coherence", "held-out", "webgl", "webgpu", "detector"]},
              "id": {"type": "string", "minLength": 1},
              "sha256": {"type": ["string", "null"]},
              "retained": {"type": "boolean"}
            }
          }
        },
        "native_constraints": {
          "type": "object",
          "additionalProperties": false,
          "required": ["webgl_extensions", "webgl_limits", "webgl_precision", "webgpu_features", "webgpu_limits", "missing_capabilities"],
          "properties": {
            "webgl_extensions": {"const": "remove-only"},
            "webgl_limits": {"const": "host-clamped"},
            "webgl_precision": {"const": "override-only-when-supplied"},
            "webgpu_features": {"const": "native-intersection"},
            "webgpu_limits": {"const": "native-intersection"},
            "missing_capabilities": {"const": "not-fabricated"}
          }
        },
        "known_limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
