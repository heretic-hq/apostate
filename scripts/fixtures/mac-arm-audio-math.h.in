#ifndef THIRD_PARTY_BLINK_RENDERER_PLATFORM_AUDIO_MAC_ARM_AUDIO_MATH_H_
#define THIRD_PARTY_BLINK_RENDERER_PLATFORM_AUDIO_MAC_ARM_AUDIO_MATH_H_

#include <array>
#include <bit>
#include <cfenv>
#include <cmath>
#include <cstdint>
#include <limits>

#include "base/compiler_specific.h"
#include "build/build_config.h"

#if defined(ARCH_CPU_X86_FAMILY)
#include <xmmintrin.h>
#endif

namespace blink::mac_arm_audio_math {
namespace internal {

// Scalar range reduction for the Mac ARM audio math policy. The hexadecimal
// constants and explicit double FMA order preserve the target rounding.
// These tables reduce arbitrary inputs; they contain no audio output data.
inline bool FlushInputs() {
#if defined(ARCH_CPU_ARM64)
  uint64_t control;
  asm volatile("mrs %0, fpcr" : "=r"(control));
  return control & (uint64_t{1} << 24);
#elif defined(ARCH_CPU_ARM_FAMILY)
  uint32_t control;
  asm volatile("vmrs %0, fpscr" : "=r"(control));
  return control & (uint32_t{1} << 24);
#elif defined(ARCH_CPU_X86_FAMILY)
  return _mm_getcsr() & 0x40;
#else
  return false;
#endif
}

ALWAYS_INLINE float Log10(float value) {
  uint32_t word = std::bit_cast<uint32_t>(value);
  if (word - 0x00800000u >= 0x7f000000u) {
    const uint32_t magnitude = word & 0x7fffffffu;
    if (magnitude > 0x7f800000u) {
      if (!(word & 0x00400000u)) {
        std::feraiseexcept(FE_INVALID);
      }
      return value;
    }
    if (magnitude == 0 || (magnitude < 0x00800000u && FlushInputs())) {
      std::feraiseexcept(FE_DIVBYZERO);
      return -std::numeric_limits<float>::infinity();
    }
    if (word & 0x80000000u) {
      std::feraiseexcept(FE_INVALID);
      return std::bit_cast<float>(0x7fc00000u);
    }
    if (magnitude == 0x7f800000u) {
      return value;
    }
    // Normalize the integer mantissa without losing subnormal input bits.
    const float normalized = std::bit_cast<float>(word | 0x3f800000u) - 1.f;
    word = std::bit_cast<uint32_t>(normalized) - 0x3f000000u;
  }
  struct Entry {
    double reciprocal;
    double logarithm;
  };
  static constexpr std::array<Entry, 65> kTable = {{
@LOG_TABLE@
  }};
  const int exponent = std::bit_cast<int32_t>(word + 0xc0c10000u) >> 23;
  const uint32_t mantissa = word & 0x007fffffu;
  const unsigned index = (mantissa + 0x00010000u) >> 17;
  const double fraction = std::bit_cast<float>(mantissa | 0x3f800000u);
  const double residual = std::fma(fraction, kTable[index].reciprocal, -1.0);
  double polynomial = std::fma(residual, -0x1.bcbea4c258daap-4,
                               0x1.287d3dcaf476dp-3);
  polynomial = std::fma(residual, polynomial, -0x1.bcb7b14dcbd85p-3);
  polynomial = std::fma(residual, polynomial, 0x1.bcb7b151bc6b3p-2);
  const double base = std::fma(static_cast<double>(exponent),
                               0x1.34413509f79ffp-2, kTable[index].logarithm);
  return static_cast<float>(std::fma(residual, polynomial, base));
}

ALWAYS_INLINE float Exp10(float value) {
  const uint32_t word = std::bit_cast<uint32_t>(value);
  const uint32_t magnitude = word & 0x7fffffffu;
  if (magnitude >= 0x42800000u) {
    if ((word & 0x80000000u) && magnitude <= 0x7f800000u) {
      if (magnitude != 0x7f800000u) {
        std::feraiseexcept(FE_UNDERFLOW | FE_INEXACT);
      }
      return 0.f;
    }
    return value * std::numeric_limits<float>::max();
  }
  static constexpr std::array<double, 128> kTable = {{
@EXP_TABLE@
  }};
  const double scaled = static_cast<double>(value) * 0x1.a934f0979a371p+8;
  // Nearest with ties away, matching FRINTA independently of ambient mode.
  const double rounded = std::round(scaled);
  const int64_t n = static_cast<int64_t>(rounded);
  const double residual = scaled - rounded;
  const unsigned index = static_cast<uint64_t>(n) & 127u;
  const int64_t exponent = n >> 7;
  const uint64_t bits = std::bit_cast<uint64_t>(kTable[index]) +
                        (static_cast<uint64_t>(exponent) << 52);
  const double power = std::bit_cast<double>(bits);
  const double polynomial = std::fma(0x1.ebfbdff30d656p-17, residual,
                                      0x1.62e4453e10daep-8);
  const double adjustment = polynomial * residual;
  return static_cast<float>(std::fma(adjustment, power, power));
}

}  // namespace internal

using UnaryFunction = float (*)(float);
struct Functions {
  UnaryFunction log10;
  UnaryFunction exp10;
};
inline Functions PortableFunctions() {
  return {internal::Log10, internal::Exp10};
}
#if defined(ARCH_CPU_X86_64)
// The arithmetic bodies inline here before instruction selection. Callers
// must check both CPU FMA support and OS-enabled AVX state.
__attribute__((target("fma"))) inline float Log10Fma(float value) {
  return internal::Log10(value);
}
__attribute__((target("fma"))) inline float Exp10Fma(float value) {
  return internal::Exp10(value);
}
inline Functions FmaFunctions() {
  return {Log10Fma, Exp10Fma};
}
#endif

}  // namespace blink::mac_arm_audio_math

#endif  // THIRD_PARTY_BLINK_RENDERER_PLATFORM_AUDIO_MAC_ARM_AUDIO_MATH_H_
