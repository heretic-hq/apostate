# Standalone diagnostic only. No browser, installer or runtime target depends on it.
# Non-component linkage is required for the test's strict dlopen/dlerror boundary.
if (is_linux && use_dawn && !is_component_build) {
  executable("apostate_dawn_software_check") {
    testonly = true
    sources = [ "apostate_dawn_software_check.cc" ]
    deps = [
      "//base",
      "//crypto",
      "//third_party/dawn/include/dawn:cpp_headers",
      "//third_party/dawn/src/dawn:proc",
      "//third_party/dawn/src/dawn/native:native",
    ]
    libs = [ "dl" ]
    ldflags = [
      "-Wl,--wrap=dlopen",
      "-Wl,--wrap=dlerror",
    ]
  }
}
